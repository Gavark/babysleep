# Random ≥ 32 chars (e.g. `openssl rand -base64 36`)
SESSION_SECRET=replace-me-with-a-random-string

# Optional. If left empty, the first time you open the app you'll be sent to
# a /setup wizard that creates the admin account interactively. Set these
# only for scripted/automated deployments where you don't want to click
# through a browser. They're only consulted ONCE, when the users table is
# still empty.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-please-10-chars-min

# Optional overrides
TZ=Europe/Paris
DISABLE_SIGNUP=false

# Public URL of the deployment (used as Origin/CSRF reference).
# Behind Caddy (or any reverse proxy with HTTPS), set the public https URL.
# For local-only HTTP testing without proxy, set to http://localhost:3000
ORIGIN=https://your.domain.example

# Backup sidecar config (optional overrides)
# BACKUP_RETENTION=30
# BACKUP_SCHEDULE=0 3 * * *
